
# -------------------------------------------------------------------
# Version control
# -------------------------------------------------------------------
# verified versions of each component below
# freertos versions: freertos_v10.4.3
# lwip versions    : lwip_v2.1.3
# mbedtls versions : mbedtls-3.6.3 / mbedtls-2.28.1

FREERTOS_VERSION   = freertos_v10.4.3
LWIP_VERSION       = lwip_v2.1.3
MBEDTLS_VERSION    = mbedtls-2.28.1

# -------------------------------------------------------------------
# AWS Directories Definition
# -------------------------------------------------------------------
AWS_MBEDTLSDIR  = $(AWS_FREERTOS_DIR)/libraries/3rdparty/$(MBEDTLS_VERSION)
AWS_FREERTOSDIR = $(SDKROOTDIR)/component/os/freertos/$(FREERTOS_VERSION)

# -------------------------------------------------------------------
# AWS C flags
# -------------------------------------------------------------------
CFLAGS += -DCONFIG_AMEBAZ2
CFLAGS += -DCONFIG_AMAZON_FREERTOS=1

CFLAGS += -DconfigINCLUDE_FREERTOS_TASK_C_ADDITIONS_H=1

CFLAGS += -DCONFIG_MBEDTLS_AMAZON_DEFINED=1
CFLAGS += -DMBEDTLS_CONFIG_FILE=\<aws_mbedtls_config.h\>
ifeq ($(MBEDTLS_VERSION), mbedtls-3.6.3)
CFLAGS += -DMBEDTLS_VERSION_NUMBER=0x03060300
CFLAGS += -DMBEDTLS_ALLOW_PRIVATE_ACCESS
CFLAGS += -DMBEDTLS_SSL_DTLS_CONNECTION_ID_COMPAT=0
else ifeq ($(MBEDTLS_VERSION), mbedtls-2.28.1)
CFLAGS += -DMBEDTLS_VERSION_NUMBER=0x021C0100
endif
